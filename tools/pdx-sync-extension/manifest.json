{
  "manifest_version": 3,
  "name": "EQP - Komatsu PDX Session Sync",
  "version": "1.1.0",
  "description": "Automatically syncs your Komatsu PDX login session to the EQP System whenever it changes",
  "permissions": [
    "cookies",
    "clipboardWrite",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.komatsu.ae/*",
    "https://eqp-1.onrender.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync Komatsu PDX Session"
  }
}
